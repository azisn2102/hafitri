# --- Model (API OpenAI-compatible: OpenRouter, OpenAI, Gemini OpenAI-compat, dll) ---
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
MAX_STEPS=24

# --- Browser sesi login (opsional, dipakai tool "browser") ---
# Kosongkan untuk autodetect Chromium dari cache Playwright / Chrome sistem.
# BROWSER_BIN=/home/.cache/ms-playwright/chromium-1248/chrome-linux-arm64/chrome
# Halaman pertama saat sesi browser dinyalakan (default: halaman login Google)
BROWSER_START_URL=https://accounts.google.com/
BROWSER_DISPLAY=:99
CDP_PORT=9222
VNC_PORT=5900
NOVNC_PORT=6080
NOVNC_ADDR=127.0.0.1
